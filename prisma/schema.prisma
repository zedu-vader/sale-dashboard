generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum LeadType {
  INDIVIDUAL
  BUSINESS
}

// Pipeline stages in order. LOST is an exit from any stage and needs a lostReason.
enum LeadStatus {
  NEW
  CONTACTED
  CONNECTED
  INTERESTED
  FOLLOW_UP
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LostReason {
  NOT_INTERESTED
  NO_BUDGET
  WRONG_CONTACT
  WENT_WITH_COMPETITOR
  OTHER
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  NOT_INTERESTED
  OTHER
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  phone        String
  type         LeadType
  status       LeadStatus
  lostReason   LostReason?
  ownerName    String
  nextAction   String?
  nextActionAt DateTime?
  createdAt    DateTime   @default(now())
  calls        Call[]

  @@index([createdAt])
}

model Call {
  id       String      @id @default(cuid())
  leadId   String?
  outcome  CallOutcome
  calledAt DateTime    @default(now())
  lead     Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([calledAt])
  @@index([leadId])
}

model Task {
  id       String   @id @default(cuid())
  title    String
  subtitle String?
  dueAt    DateTime
  done     Boolean  @default(false)
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dueAt])
}
